          ["AromaPacifico/Cost", "MonthToDateCost", "CollectionCenter", "tolima", {"stat": "Maximum", "label": "tolima"}],
          ["AromaPacifico/Cost", "MonthToDateCost", "CollectionCenter", "none", {"stat": "Maximum", "label": "none"}]
        ]
