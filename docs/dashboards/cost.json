    },
    {
      "type": "metric",
      "x": 8,
      "y": 12,
      "width": 8,
      "height": 6,
      "properties": {
        "title": "CO-08 Farms line, month to date and mean per enrolled farm",
        "region": "us-east-1",
        "view": "singleValue",
        "stat": "Maximum",
        "period": 86400,
        "metrics": [
          ["AromaPacifico/Cost", "MonthToDateCost", "CostLine", "farms", {"stat": "Maximum", "id": "f", "label": "Farms line"}],
          [{"expression": "f / ${enrolled_farms}", "label": "Mean per enrolled farm", "id": "e1"}]
        ]
      }
    },
