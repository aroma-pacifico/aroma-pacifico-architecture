{
  "start": "-P31D",
  "periodOverride": "inherit",
  "widgets": [
    {
      "type": "text",
      "x": 0,
      "y": 0,
      "width": 24,
      "height": 2,
      "properties": {
        "markdown": "# CO-00 Aroma Pacifico cost\nAmounts are what the bill says; no price is set here (prices and budget amounts are A23, roadmap#36). Cost lines follow the A08 cost category: farms, drones, collection centers, trips, testing, shared and `unallocated`. Daily values come from Cost Explorer through the cost export function and lag up to one day."
      }
    },
    {
      "type": "metric",
      "x": 0,
      "y": 2,
      "width": 6,
      "height": 4,
      "properties": {
        "title": "CO-01 Estimated charges, month to date (USD)",
        "region": "us-east-1",
        "view": "singleValue",
        "stat": "Maximum",
        "period": 21600,
        "metrics": [["AWS/Billing", "EstimatedCharges", "Currency", "USD", {"stat": "Maximum", "label": "All accounts"}]]
      }
    },
    {
      "type": "metric",
      "x": 6,
      "y": 2,
      "width": 6,
      "height": 4,
      "properties": {
        "title": "CO-02 Unallocated cost, month to date",
        "region": "us-east-1",
        "view": "singleValue",
        "stat": "Maximum",
        "period": 86400,
        "metrics": [
          [{"expression": "100 * u / t", "label": "Unallocated % (alarm above 5)", "id": "e1"}],
          ["AromaPacifico/Cost", "MonthToDateCost", "CostLine", "unallocated", {"stat": "Maximum", "id": "u", "visible": false}],
          ["AromaPacifico/Cost", "MonthToDateCost", "CostLine", "total", {"stat": "Maximum", "id": "t", "visible": false}]
        ]
      }
    },
    {
      "type": "metric",
      "x": 12,
      "y": 2,
      "width": 6,
      "height": 4,
      "properties": {
        "title": "CO-03 Testing cost line, month to date",
        "region": "us-east-1",
        "view": "singleValue",
        "stat": "Maximum",
        "period": 86400,
        "metrics": [["AromaPacifico/Cost", "MonthToDateCost", "CostLine", "testing", {"stat": "Maximum", "label": "Testing (dev and qa accounts)"}]]
      }
    },
    {
      "type": "alarm",
      "x": 18,
      "y": 2,
      "width": 6,
      "height": 4,
      "properties": {
        "title": "CO-04 Cost alarms",
        "alarms": [
          "arn:aws:cloudwatch:us-east-1:${management_account_id}:alarm:${prefix}-shared-alarm-unallocated",
          "arn:aws:cloudwatch:us-east-1:${management_account_id}:alarm:${prefix}-shared-alarm-natcost"
        ],
        "sortBy": "stateUpdatedTimestamp"
      }
    },
    {
      "type": "metric",
      "x": 0,
      "y": 6,
      "width": 12,
      "height": 6,
      "properties": {
        "title": "CO-05 Daily cost by pilot cost line",
        "region": "us-east-1",
        "view": "bar",
        "stat": "Maximum",
        "period": 86400,
        "metrics": [{"expression": "SEARCH('{AromaPacifico/Cost,CostLine} MetricName=\"DailyCost\"', 'Maximum', 86400)", "id": "e1"}],
        "start": "-P35D",
        "end": "P0D",
        "stacked": true
      }
    },
    {
      "type": "metric",
      "x": 12,
      "y": 6,
