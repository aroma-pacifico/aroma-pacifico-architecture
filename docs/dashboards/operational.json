{
  "start": "-PT24H",
  "periodOverride": "inherit",
  "widgets": [
    {
      "type": "text",
      "x": 0,
      "y": 0,
      "width": 24,
      "height": 2,
      "properties": {
        "markdown": "# OP-00 Aroma Pacifico operations (${env})\nPoint 6 of the case statement. Every threshold is a design value from `docs/observability.md`; nothing here is a measurement. Collection centers split by the `CollectionCenter` dimension, farms by the Logs Insights tables, drones by the drone and inference rows, testing by the `dev` and `qa` copies of this dashboard."
      }
    },
    {
      "type": "metric",
      "x": 0,
      "y": 2,
      "width": 4,
      "height": 4,
      "properties": {
        "title": "OP-01 SLO 1 crop alert delivery, 28 days (objective 95 %)",
        "region": "us-east-1",
        "view": "singleValue",
        "stat": "Sum",
        "period": 86400,
        "metrics": [
          [
            {
              "expression": "100 * g / v",
              "label": "Attainment %",
              "id": "e1"
            }
          ],
          [
            "AromaPacifico/Alerts",
            "AlertDeliveryGood",
            {
              "id": "g",
              "visible": false
            }
          ],
          [
            "AromaPacifico/Alerts",
            "AlertDeliveryValid",
            {
              "id": "v",
              "visible": false
            }
          ]
        ],
        "setPeriodToTimeRange": true,
        "start": "-P28D",
        "end": "P0D"
      }
    },
    {
      "type": "metric",
      "x": 4,
      "y": 2,
      "width": 4,
      "height": 4,
      "properties": {
        "title": "OP-02 SLO 1 error budget remaining, 28 days",
        "region": "us-east-1",
        "view": "singleValue",
        "stat": "Sum",
        "period": 86400,
        "metrics": [
          [
            {
              "expression": "100 * (1 - ((v - g) / v) / 0.05)",
              "label": "Budget remaining %",
              "id": "e1"
            }
          ],
          [
            "AromaPacifico/Alerts",
            "AlertDeliveryGood",
            {
              "id": "g",
              "visible": false
            }
          ],
          [
            "AromaPacifico/Alerts",
            "AlertDeliveryValid",
            {
              "id": "v",
              "visible": false
            }
          ]
        ],
        "setPeriodToTimeRange": true,
        "start": "-P28D",
        "end": "P0D"
      }
    },
    {
      "type": "metric",
      "x": 8,
      "y": 2,
      "width": 4,
      "height": 4,
      "properties": {
        "title": "OP-03 SLO 2 sack lookup availability, 28 days (objective 99.5 %)",
        "region": "us-east-1",
        "view": "singleValue",
        "stat": "Sum",
        "period": 86400,
        "metrics": [
          [
            {
              "expression": "100 * g / v",
              "label": "Attainment %",
              "id": "e1"
            }
          ],
          [
            "AromaPacifico/Lookup",
            "LookupGood",
            {
              "id": "g",
              "visible": false
            }
          ],
          [
            "AromaPacifico/Lookup",
            "LookupValid",
            {
              "id": "v",
              "visible": false
            }
          ]
        ],
        "setPeriodToTimeRange": true,
        "start": "-P28D",
        "end": "P0D"
      }
    },
    {
      "type": "metric",
      "x": 12,
      "y": 2,
      "width": 4,
      "height": 4,
      "properties": {
        "title": "OP-04 SLO 2 error budget remaining, 28 days",
        "region": "us-east-1",
        "view": "singleValue",
        "stat": "Sum",
        "period": 86400,
        "metrics": [
          [
            {
              "expression": "100 * (1 - ((v - g) / v) / 0.005)",
              "label": "Budget remaining %",
              "id": "e1"
            }
          ],
          [
            "AromaPacifico/Lookup",
            "LookupGood",
            {
              "id": "g",
              "visible": false
            }
          ],
          [
            "AromaPacifico/Lookup",
            "LookupValid",
            {
              "id": "v",
              "visible": false
            }
          ]
        ],
        "setPeriodToTimeRange": true,
        "start": "-P28D",
        "end": "P0D"
      }
    },
    {
      "type": "alarm",
      "x": 16,
      "y": 2,
      "width": 8,
      "height": 4,
      "properties": {
        "title": "OP-05 Burn-rate alerts of both SLOs",
        "alarms": [
          "arn:aws:cloudwatch:us-east-1:${account_id}:alarm:${prefix}-${env}-alarm-sloalertfast",
          "arn:aws:cloudwatch:us-east-1:${account_id}:alarm:${prefix}-${env}-alarm-sloalertslow",
          "arn:aws:cloudwatch:us-east-1:${account_id}:alarm:${prefix}-${env}-alarm-sloalertticket",
          "arn:aws:cloudwatch:us-east-1:${account_id}:alarm:${prefix}-${env}-alarm-slolookupfast",
          "arn:aws:cloudwatch:us-east-1:${account_id}:alarm:${prefix}-${env}-alarm-slolookupslow",
          "arn:aws:cloudwatch:us-east-1:${account_id}:alarm:${prefix}-${env}-alarm-slolookupticket",
          "arn:aws:cloudwatch:us-east-1:${account_id}:alarm:${prefix}-${env}-alarm-lookupprobe"
        ],
        "sortBy": "stateUpdatedTimestamp"
      }
    },
    {
      "type": "metric",
      "x": 0,
      "y": 6,
      "width": 8,
      "height": 6,
      "properties": {
        "title": "OP-06 SLO 1 hourly good ratio and excluded openings, 7 days",
        "region": "us-east-1",
        "view": "timeSeries",
        "stat": "Sum",
        "period": 3600,
        "metrics": [
          [
            {
              "expression": "IF(v > 0, 100 * g / v)",
              "label": "Good %",
              "id": "e1"
            }
          ],
          [
            "AromaPacifico/Alerts",
            "AlertDeliveryGood",
            {
              "id": "g",
              "visible": false
            }
          ],
          [
            "AromaPacifico/Alerts",
            "AlertDeliveryValid",
            {
              "id": "v",
              "visible": false
            }
          ],
          [
            "AromaPacifico/Alerts",
            "AlertDeliveryExcluded",
            {
              "id": "x",
              "label": "Excluded (handset unreachable)",
              "yAxis": "right"
            }
          ]
        ],
        "start": "-P7D",
        "end": "P0D",
        "annotations": {
          "horizontal": [
            {
              "label": "Objective",
              "value": 95
            }
          ]
        },
        "yAxis": {
          "left": {
            "min": 0,
            "max": 100
          }
        }
      }
    },
    {
      "type": "log",
      "x": 8,
      "y": 6,
      "width": 8,
      "height": 6,
      "properties": {
        "title": "OP-07 SLO 1 bad events by breach hop, 7 days",
        "region": "us-east-1",
        "view": "table",
        "query": "SOURCE '/aws/lambda/${prefix}-${env}-lambda-obsdetector' | filter detector = \"slo_alert_judgement\" and good = 0 and excluded = 0 | stats count(*) as bad_events by breach_hop, department | sort bad_events desc"
      }
    },
    {
      "type": "metric",
      "x": 16,
      "y": 6,
      "width": 8,
      "height": 6,
      "properties": {
        "title": "OP-08 SLO 2 hourly good ratio and probe success, 7 days",
        "region": "us-east-1",
        "view": "timeSeries",
        "stat": "Sum",
        "period": 3600,
        "metrics": [
          [
            {
              "expression": "IF(v > 0, 100 * g / v)",
              "label": "Good %",
              "id": "e1"
            }
          ],
          [
            "AromaPacifico/Lookup",
            "LookupGood",
            {
              "id": "g",
              "visible": false
            }
          ],
          [
            "AromaPacifico/Lookup",
            "LookupValid",
            {
              "id": "v",
              "visible": false
            }
          ],
          [
            "CloudWatchSynthetics",
            "SuccessPercent",
            "CanaryName",
            "${prefix}-${env}-canary-lookup",
            {
              "stat": "Average",
              "label": "Probe success %"
            }
          ]
        ],
        "start": "-P7D",
        "end": "P0D",
        "annotations": {
          "horizontal": [
            {
              "label": "Objective",
              "value": 99.5
            }
          ]
        },
        "yAxis": {
          "left": {
            "min": 90,
            "max": 100
          }
        }
      }
    },
    {
      "type": "alarm",
      "x": 0,
      "y": 12,
      "width": 24,
      "height": 4,
      "properties": {
        "title": "OP-09 Page-level alarms",
        "alarms": [
          "arn:aws:cloudwatch:us-east-1:${account_id}:alarm:${prefix}-${env}-alarm-infthresholddlq",
          "arn:aws:cloudwatch:us-east-1:${account_id}:alarm:${prefix}-${env}-alarm-infthresholdage",
          "arn:aws:cloudwatch:us-east-1:${account_id}:alarm:${prefix}-${env}-alarm-infthresholdstore",
          "arn:aws:cloudwatch:us-east-1:${account_id}:alarm:${prefix}-${env}-alarm-infperson",
          "arn:aws:cloudwatch:us-east-1:${account_id}:alarm:${prefix}-${env}-alarm-iotrulefail",
          "arn:aws:cloudwatch:us-east-1:${account_id}:alarm:${prefix}-${env}-alarm-notifydlq",
          "arn:aws:cloudwatch:us-east-1:${account_id}:alarm:${prefix}-${env}-alarm-nodesilentmass",
          "arn:aws:cloudwatch:us-east-1:${account_id}:alarm:${prefix}-${env}-alarm-api5xxrate",
          "arn:aws:cloudwatch:us-east-1:${account_id}:alarm:${prefix}-${env}-alarm-sackiterage",
          "arn:aws:cloudwatch:us-east-1:${account_id}:alarm:${prefix}-${env}-alarm-sackdlq",
          "arn:aws:cloudwatch:us-east-1:${account_id}:alarm:${prefix}-${env}-alarm-lookupprobe"
        ],
        "sortBy": "stateUpdatedTimestamp"
      }
    },
    {
      "type": "text",
      "x": 0,
      "y": 16,
      "width": 24,
      "height": 1,
      "properties": {
        "markdown": "## Ingestion and farms without telemetry"
      }
    },
    {
      "type": "metric",
      "x": 0,
      "y": 17,
      "width": 8,
      "height": 6,
      "properties": {
        "title": "OP-10 Readings evaluated by department and zone",
        "region": "us-east-1",
        "view": "timeSeries",
        "stat": "Sum",
        "period": 3600,
        "metrics": [
          {
            "expression": "SEARCH('{AromaPacifico/Telemetry,CollectionCenter,Zone} MetricName=\"ReadingsEvaluated\"', 'Sum', 3600)",
            "id": "e1"
          }
        ]
      }
    },
    {
      "type": "metric",
      "x": 8,
      "y": 17,
      "width": 8,
      "height": 6,
      "properties": {
        "title": "OP-11 Ingest lag p95 and delayed readings",
        "region": "us-east-1",
        "view": "timeSeries",
        "stat": "Sum",
        "period": 3600,
        "metrics": [
          [
            "AromaPacifico/Telemetry",
            "IngestLagSeconds",
            {
              "stat": "p95",
              "label": "Ingest lag p95 (s)"
            }
          ],
          [
            "AromaPacifico/Telemetry",
            "ReadingsDelayed",
            {
              "stat": "Sum",
              "label": "Delayed readings",
              "yAxis": "right"
            }
          ],
          [
            "AromaPacifico/Telemetry",
            "ReadingsEvicted",
            {
              "stat": "Sum",
              "label": "Evicted from buffers",
              "yAxis": "right"
            }
          ]
        ]
      }
    },
    {
      "type": "metric",
      "x": 16,
      "y": 17,
      "width": 8,
      "height": 6,
      "properties": {
        "title": "OP-12 IoT Core authentication errors and rule failures",
        "region": "us-east-1",
        "view": "timeSeries",
        "stat": "Sum",
        "period": 300,
        "metrics": [
          [
            "AWS/IoT",
            "Connect.AuthError",
            {
              "label": "Connect auth errors"
            }
          ],
          [
            "AWS/IoT",
            "PublishIn.AuthError",
            {
              "label": "Publish auth errors"
            }
          ],
          [
            "AWS/IoT",
            "Failure",
            "RuleName",
            "${telemetry_rule_name}",
            "ActionType",
            "DynamoDBv2",
            {
              "label": "Rule store write failures"
            }
          ],
          [
            "AWS/IoT",
            "Failure",
            "RuleName",
            "${telemetry_rule_name}",
            "ActionType",
            "SQS",
            {
              "label": "Rule queue send failures"
            }
          ],
          [
            "AWS/SQS",
            "ApproximateNumberOfMessagesVisible",
            "QueueName",
            "${prefix}-${env}-sqs-iotruleerr",
            {
              "stat": "Maximum",
              "label": "Rule error queue depth"
            }
          ]
        ]
      }
    },
    {
      "type": "metric",
      "x": 0,
      "y": 23,
      "width": 8,
      "height": 6,
      "properties": {
        "title": "OP-13 Nodes and farms silent for more than 24 hours, by department",
        "region": "us-east-1",
        "view": "timeSeries",
        "stat": "Maximum",
        "period": 3600,
        "metrics": [
          {
            "expression": "SEARCH('{AromaPacifico/Detector,CollectionCenter} MetricName=\"NodesSilent24h\"', 'Maximum', 3600)",
            "id": "e1",
            "label": "Nodes"
          },
          {
            "expression": "SEARCH('{AromaPacifico/Detector,CollectionCenter} MetricName=\"FarmsSilent24h\"', 'Maximum', 3600)",
            "id": "e2",
            "label": "Farms"
          }
        ]
      }
    },
    {
      "type": "log",
      "x": 8,
      "y": 23,
      "width": 16,
      "height": 6,
      "properties": {
        "title": "OP-14 Silent nodes by farm (last detector run)",
        "region": "us-east-1",
        "view": "table",
        "query": "SOURCE '/aws/lambda/${prefix}-${env}-lambda-obsdetector' | filter detector = \"node_silence\" and silent_hours > 8 | stats latest(silent_hours) as hours_silent, latest(last_received_at) as last_received by farm_id, node_id, zone, department | sort hours_silent desc | limit 200"
      }
    },
